alphabet = "asdfwerzxcuioptbm"
enabled_builtin_patterns = [
  "ip",
  "uuid",
  "sha",
  "digit",
  "url",
  "path",
  "hex",
  "kubernetes",
  "git-status",
  "git-status-branch",
  "diff",
]

[popup]
width = "90%"
height = "90%"

[[profiles]]
name = "laptop"
max_client_width = 310
width = "95%"
height = "90%"

[[profiles]]
name = "partial-ultrawide"
max_client_width = 350
width = "90%"
height = "90%"

[[profiles]]
name = "full-ultrawide"
min_client_width = 400
width = "70%"
height = "90%"

[[patterns]]
name = "git-ssh"
regex = 'git@[a-zA-Z0-9.-]+:[a-zA-Z0-9/.-]+\.git'

[[patterns]]
name = "user-uuid"
regex = '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

[[patterns]]
name = "user-sha"
regex = '[0-9a-f]{7,40}'

[[patterns]]
name = "file-line"
regex = '/[^ \t\r\n]+:[0-9]+'

[[patterns]]
name = "hostname"
regex = '(?i)\b(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}\b'

[[patterns]]
name = "ticket"
regex = "TKT-[0-9]+"

[[patterns]]
name = "captured-ticket"
regex = "ticket=(?<match>TKT-[0-9]+)"
